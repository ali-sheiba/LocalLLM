# Avuja experiment 11 diagnostic control — no drafter, prefix cache enabled
# Target: https://huggingface.co/Avuja/Qwen3.8-27B-int4-AutoRound
#
# This is not a promotion candidate. It reproduces P11's target, template, FP8
# KV, Mamba align mode, synchronous scheduler, and memory envelope with external
# speculation disabled. Repeated-prefix hits here isolate P11's zero-hit failure
# to DFlash/spec-decode hybrid cache reconciliation rather than prompt hashing.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: not applicable — diagnostic prefix-reuse control only
# tool-eval-bench: not run
# llama-benchy: not run
# Manual notes: Confirmed. Two identical ~5K-token prompts took 5.44s then 1.37s; metrics reported 4,704 prefix hits / 10,102 queries. The control exposed 508,268 KV tokens (3.88x at 131K), versus P11 DFlash2's 221,379 tokens (1.69x).
# BENCHMARK_SUMMARY_END

VLLM_IMAGE=vllm/vllm-openai:v0.27.1
CONTAINER_NAME=local-llm-qwen3.8-27b-avuja-dflash2-vllm
MODEL_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/Avuja/Qwen3.8-27B-int4-AutoRound
DRAFTER_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/incoai/Qwen3.8-27B-DFlash2
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/etc/qwen-custom-chat-template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
QUANTIZATION=auto_round
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.80
KV_CACHE_DTYPE=fp8_e4m3
PREFIX_CACHE_ARG=--enable-prefix-caching
MAMBA_CACHE_MODE=align
CHUNKED_PREFILL_ARG=--enable-chunked-prefill
ASYNC_SCHEDULING_ARG=--no-async-scheduling
CUSTOM_ALL_REDUCE_ARG=--disable-custom-all-reduce
FLASHINFER_AUTOTUNE_ARG=--enable-flashinfer-autotune

DRAFT_SPEC_N=0
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_DFLASH2_DRAFT_TOPK_TOPP=1
VLLM_DFLASH2_TORCH_TOPK=0
VLLM_USE_FLASHINFER_SAMPLER=1

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
