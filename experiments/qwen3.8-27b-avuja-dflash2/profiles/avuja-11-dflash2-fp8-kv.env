# Avuja experiment 11 — external DFlash2 n=7, two-agent FP8-KV tier
# Target: https://huggingface.co/Avuja/Qwen3.8-27B-int4-AutoRound
# Drafter: https://huggingface.co/incoai/Qwen3.8-27B-DFlash2
# Integration: Club-3090 PR #1072 backport pinned in ../vendor/.
#
# Hypothesis: replacing Avuja's unstable built-in MTP head with the independently
# trained DFlash2 drafter can exceed Lorbus's depth-0 c2 record (71.12 t/s per
# agent) without changing target-model output semantics. This first arm favors
# two-session capacity and context over the BF16-KV/FA2 single-stream headline.
#
# Promotion gates:
# - c2 depth 0 > 71.12 t/s per agent, using the Avuja tokenizer explicitly.
# - Tool-eval >= 91 with zero safety warnings across repeated trials.
# - Stable DFlash acceptance through >20K generated tokens and two concurrent
#   coding sessions, including context compression and tool-heavy turns.
# - Follow-up prompts reuse their prefix rather than reprocessing full context.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: benchmarks/runs/2026/08/20260820T174124Z-avuja-qwen3-8-27b-int4-autoround-212a7a5d/report.md (run 20260820T174124Z-avuja-qwen3-8-27b-int4-autoround-212a7a5d)
# tool-eval-bench: score=91, completion=—, safety_warnings=1
# llama-benchy c1: 0=92.52, 8K=86.90, 32K=64.15 tg tok/s
# llama-benchy c2: 0=65.00 aggregate / 32.50 per-agent, 8K=66.89 aggregate / 33.44 per-agent, 32K=8.61 aggregate / 4.31 per-agent tg tok/s
# Manual notes: Rejected. Booted with V2 DFlash2, zero restarts, 221,379-token KV pool (1.69x at 131K), and 48.0% pooled draft acceptance. Identical ~5K-token requests and two full benchmark runs produced zero prefix-cache hits (about 1.90M queried tokens), so follow-up context was reprocessed. See benchmarks/comparisons/avuja-dflash2-evaluation-2026-08-20.md.
# BENCHMARK_SUMMARY_END

VLLM_IMAGE=vllm/vllm-openai:v0.27.1
CONTAINER_NAME=vllm-qwen38-27b-avuja-dflash2
MODEL_HOST_PATH=/home/app/models/Avuja/Qwen3.8-27B-int4-AutoRound
DRAFTER_HOST_PATH=/home/app/models/incoai/Qwen3.8-27B-DFlash2
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/etc/qwen-custom-chat-template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=/home/app/models/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
QUANTIZATION=auto_round
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.80
KV_CACHE_DTYPE=fp8_e4m3
PREFIX_CACHE_ARG=--enable-prefix-caching
MAMBA_CACHE_MODE=align
CHUNKED_PREFILL_ARG=--enable-chunked-prefill
ASYNC_SCHEDULING_ARG=--no-async-scheduling
CUSTOM_ALL_REDUCE_ARG=--disable-custom-all-reduce
FLASHINFER_AUTOTUNE_ARG=--enable-flashinfer-autotune

DRAFT_SPEC_N=7
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_DFLASH2_DRAFT_TOPK_TOPP=1
VLLM_DFLASH2_TORCH_TOPK=0
VLLM_USE_FLASHINFER_SAMPLER=1

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
