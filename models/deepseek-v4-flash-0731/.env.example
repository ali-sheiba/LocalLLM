# DeepSeek-V4-Flash-0731 — dual RTX 3090 (24 GiB each) tuning profile.
# Copy to .env to override any value. Keep a single stack active on port 8080.
# This profile assumes the full 16-core / 32-thread, 64 GiB RAM host.

PORT=8080
MODEL_QUANT=UD-IQ1_S
MODEL_ALIAS=deepseek-v4-flash-0731

# Each of the 48 GiB total GPU VRAM must also hold KV and CUDA work buffers.
# This placement is the starting point for the 77 GiB IQ1_S target.
N_GPU_LAYERS=33
N_CPU_MOE=10
TENSOR_SPLIT=1,1

# One interactive coding-agent session.  Increasing NP shares the fixed context
# across slots and, with DSpark, usually hurts per-session generation speed.
CTX_SIZE=32768
NP=1
BATCH_SIZE=2048
UBATCH_SIZE=512

# 16 physical cores / 32 hardware threads.  Reduce only if another CPU-heavy
# workload must run simultaneously.
THREADS=32
THREADS_BATCH=32

# Q8 KV is a quality-first choice at 32K.  Set both to q4_0 before raising
# context substantially, then benchmark accuracy and throughput.
KV_TYPE_K=q8_0
KV_TYPE_V=q8_0

# Keep RAM prompt-cache bookkeeping bounded. Prompt reuse remains enabled.
CACHE_RAM=512

# Native DSpark delivers its best documented single-session decode rate at 3
# draft tokens, but its 11 GiB sidecar competes with target layers. Because this
# 77 GiB target is already partly CPU-resident, benchmark it before enabling.
# Start with the stable target-only profile above. To test DSpark, uncomment:
# SPEC_ARGS=--spec-type draft-dspark --spec-draft-model /models/dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf --spec-draft-ngl all --spec-draft-n-max 3 --spec-draft-n-min 0 --spec-draft-p-min 0.0 --spec-draft-type-k q8_0 --spec-draft-type-v q8_0

# DeepSeek's recommended sampling.  Use TOP_P=1.0 for non-agentic chat.
REASONING=on
REASONING_FORMAT=deepseek
TEMP=1.0
TOP_P=0.95
MIN_P=0.01
