# Optional overrides for docker-compose.yml. Copy to .env only when needed.

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
SERVED_MODEL_NAME=qwen3.8-27b

# Two parallel agent sessions with the checkpoint's native 262K request limit.
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.92

# Recommended on RTX 3090: dynamic scales and the same 1-byte footprint as FP8.
# A/B alternatives: fp8_e4m3 (more checkpoint-author parity), bfloat16 (quality,
# but substantially less context capacity).
KV_CACHE_DTYPE=int8_per_token_head

# Prefix caching is useful for repeated agent system prompts/tool schemas. These
# values must be changed together when disabling it.
PREFIX_CACHE_ARG=--enable-prefix-caching
MAMBA_CACHE_MODE=align

# Reliable tool-calling default. For difficult planning/coding tasks, enable
# thinking and let the client request a generous max_tokens budget. Qwen's
# thinking-mode sampling recommendation is TEMPERATURE=1.0 and TOP_P=0.95.
ENABLE_THINKING=false
REASONING_EFFORT=xhigh
TOOL_PARSER=qwen3_coder

# Non-thinking instruct/tool-use sampling defaults.
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
