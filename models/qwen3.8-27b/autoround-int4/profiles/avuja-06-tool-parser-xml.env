# Avuja experiment 06 — Qwen XML tool-call parser
# Control: avuja.env, run 20260819T180403Z-avuja-qwen3-8-27b-int4-autoround-c9f9fb98
# Change only TOOL_PARSER from qwen3_coder to qwen3_xml.
# Hypothesis: the checkpoint-native XML template may parse multi-step and
# structured calls more reliably. This is a quality/tool-call experiment.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: benchmarks/runs/2026/08/20260820T100811Z-avuja-qwen3-8-27b-int4-autoround-fbc853aa/report.md (run 20260820T100811Z-avuja-qwen3-8-27b-int4-autoround-fbc853aa)
# Profile SHA-256 at benchmark launch: ab5ccbef034d052a14ba0ae3acb0178695aa75e75bd81c1d20c3b7aa8b21f428
# tool-eval-bench: score=88, completion=—, safety_warnings=1
# llama-benchy c1: 0=68.30, 8K=62.05, 32K=49.18 tg tok/s
# llama-benchy c2: 0=69.86 aggregate / 34.93 per-agent, 8K=24.67 aggregate / 12.34 per-agent, 32K=7.94 aggregate / 3.97 per-agent tg tok/s
# Manual notes: pending — test long coding sessions for loops, stalled calls, and malformed tool calls.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/Avuja/Qwen3.8-27B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/models/model/chat_template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=int8_per_token_head
PREFIX_CACHE_ARG=--no-enable-prefix-caching
MAMBA_CACHE_MODE=none
CHUNKED_PREFILL_ARG=--enable-chunked-prefill

TOOL_PARSER=qwen3_xml
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
