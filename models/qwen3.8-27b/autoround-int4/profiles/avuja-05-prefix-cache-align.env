# Avuja experiment 05 — prefix cache with aligned Mamba state
# Control: avuja.env, run 20260819T180403Z-avuja-qwen3-8-27b-int4-autoround-c9f9fb98
# Change the required pair: enable prefix caching and MAMBA_CACHE_MODE=align.
# Hypothesis: lower real-agent repeated-schema TTFT. llama-benchy uses --no-cache,
# so manual multi-turn checks are required; stop on recurrent-state corruption.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: benchmarks/runs/2026/08/20260820T094951Z-avuja-qwen3-8-27b-int4-autoround-aef5842c/report.md (run 20260820T094951Z-avuja-qwen3-8-27b-int4-autoround-aef5842c)
# Profile SHA-256 at benchmark launch: eb67ecae27a6312e69b29a74b032ddf0ab795a5ae3671119df623628e2f9971c
# tool-eval-bench: score=88, completion=—, safety_warnings=1
# llama-benchy c1: 0=68.75, 8K=62.60, 32K=49.45 tg tok/s
# llama-benchy c2: 0=70.98 aggregate / 35.49 per-agent, 8K=37.63 aggregate / 18.82 per-agent, 32K=9.06 aggregate / 4.53 per-agent tg tok/s
# Manual notes: pending — test long coding sessions for loops, stalled calls, and malformed tool calls.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/Avuja/Qwen3.8-27B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/models/model/chat_template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=int8_per_token_head
PREFIX_CACHE_ARG=--enable-prefix-caching
MAMBA_CACHE_MODE=align
CHUNKED_PREFILL_ARG=--enable-chunked-prefill

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
