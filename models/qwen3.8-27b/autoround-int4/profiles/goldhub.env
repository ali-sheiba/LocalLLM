# goldhub/Qwen3.8-27B-INT4-W4A16-AutoRound — stable two-agent baseline
# Source: https://huggingface.co/goldhub/Qwen3.8-27B-INT4-W4A16-AutoRound
#
# W4A16, group size 32, with more BF16-preserved layers than the other INT4
# profiles. Its native template is the baseline; test froggeric only as a
# separate copied profile. MTP and prefix caching remain off initially.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: benchmarks/runs/2026/08/20260819T190857Z-goldhub-qwen3-8-27b-int4-w4a16-autoround-48a57d75/report.md (run 20260819T190857Z-goldhub-qwen3-8-27b-int4-w4a16-autoround-48a57d75)
# Profile SHA-256 at benchmark launch: 27e8d69a902e5e1558b6ab2b13aa8c0be9c5b6ce857c0d9502d2eb9fb6ed693b
# tool-eval-bench: score=91, completion=—, safety_warnings=1
# llama-benchy c1: 0=50.11, 8K=46.64, 32K=38.90 tg tok/s
# llama-benchy c2: 0=62.47 aggregate / 31.23 per-agent, 8K=26.85 aggregate / 13.43 per-agent, 32K=8.96 aggregate / 4.48 per-agent tg tok/s
# Manual notes: pending — test long coding sessions for loops, stalled calls, and malformed tool calls.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/goldhub/Qwen3.8-27B-INT4-W4A16-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/models/model/chat_template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=int8_per_token_head
PREFIX_CACHE_ARG=--no-enable-prefix-caching
MAMBA_CACHE_MODE=none
CHUNKED_PREFILL_ARG=--enable-chunked-prefill

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
