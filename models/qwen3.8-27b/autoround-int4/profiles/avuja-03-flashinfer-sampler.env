# Avuja experiment 03 — FlashInfer sampler
# Control: avuja.env, run 20260819T180403Z-avuja-qwen3-8-27b-int4-autoround-c9f9fb98
# Change only VLLM_USE_FLASHINFER_SAMPLER from 0 to 1.
# Hypothesis: improve sampled decode throughput without changing sampling
# parameters. Validate tool-call quality and output determinism explicitly.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: benchmarks/runs/2026/08/20260820T090652Z-avuja-qwen3-8-27b-int4-autoround-4b90c1c7/report.md (run 20260820T090652Z-avuja-qwen3-8-27b-int4-autoround-4b90c1c7)
# Profile SHA-256 at benchmark launch: f5f647001b9b1d3a6a4b6bea91aa873822a9e53ed70381c36491edadc2c1fc64
# tool-eval-bench: score=88, completion=—, safety_warnings=1
# llama-benchy c1: 0=69.31, 8K=62.88, 32K=49.73 tg tok/s
# llama-benchy c2: 0=71.90 aggregate / 35.95 per-agent, 8K=25.45 aggregate / 12.72 per-agent, 32K=8.13 aggregate / 4.06 per-agent tg tok/s
# Manual notes: pending — test long coding sessions for loops, stalled calls, and malformed tool calls.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/Avuja/Qwen3.8-27B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/models/model/chat_template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
VLLM_USE_FLASHINFER_SAMPLER=1
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=int8_per_token_head
PREFIX_CACHE_ARG=--no-enable-prefix-caching
MAMBA_CACHE_MODE=none
CHUNKED_PREFILL_ARG=--enable-chunked-prefill

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
