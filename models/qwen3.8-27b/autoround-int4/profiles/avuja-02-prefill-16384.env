# Avuja experiment 02 — larger prefill batch
# Control: avuja.env, run 20260819T180403Z-avuja-qwen3-8-27b-int4-autoround-c9f9fb98
# Change only MAX_NUM_BATCHED_TOKENS from 8192 to 16384.
# Hypothesis: improve 8K/32K prompt throughput and TTFT; decode quality should
# be unchanged. Watch for prefill spikes or c2 instability.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: benchmarks/runs/2026/08/20260820T084730Z-avuja-qwen3-8-27b-int4-autoround-781666d6/report.md (run 20260820T084730Z-avuja-qwen3-8-27b-int4-autoround-781666d6)
# Profile SHA-256 at benchmark launch: b263d5676cd098c84b226856ee20592e96f4fff060f7296a73f6842d2400e1df
# tool-eval-bench: score=90, completion=—, safety_warnings=0
# llama-benchy c1: 0=68.56, 8K=62.36, 32K=49.35 tg tok/s
# llama-benchy c2: 0=73.05 aggregate / 36.52 per-agent, 8K=26.75 aggregate / 13.37 per-agent, 32K=10.78 aggregate / 5.39 per-agent tg tok/s
# Manual notes: pending — test long coding sessions for loops, stalled calls, and malformed tool calls.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/Avuja/Qwen3.8-27B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/models/model/chat_template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=16384
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=int8_per_token_head
PREFIX_CACHE_ARG=--no-enable-prefix-caching
MAMBA_CACHE_MODE=none
CHUNKED_PREFILL_ARG=--enable-chunked-prefill

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
