# Frozenlock/Qwen3.8-27B-int4-AutoRound — source-aligned MTP fast experiment
# Source: https://huggingface.co/Frozenlock/Qwen3.8-27B-int4-AutoRound
# Community reference: https://github.com/noonghunna/club-3090/blob/master/models/qwen3.8-27b/vllm/compose/dual/autoround-int4/mtp.yml
#
# W4A16, group size 128, symmetric AutoRound packing. The model card recommends
# AutoRound, FP8 KV, prefix caching, and built-in MTP. This experiment follows
# the Club-3090 measurements for this exact checkpoint: 262K context, MTP n=4,
# GPU utilization 0.90, and ONE sequence. That source measured an OOM at two
# sequences with n=4 on dual RTX 3090s; do not raise MAX_NUM_SEQS before a
# separate concurrency benchmark. The community W4A8 path additionally needs
# runtime patches and is deliberately outside this portable W4A16 experiment.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: benchmarks/runs/2026/08/20260820T125958Z-frozenlock-qwen3-8-27b-int4-autoround-da2398d8/report.md (run 20260820T125958Z-frozenlock-qwen3-8-27b-int4-autoround-da2398d8)
# Profile SHA-256 at benchmark launch: 70ba6d271332f41439e336756945c6fc873a06eaf2de6b195dcad54096a44711
# tool-eval-bench: score=90, completion=—, safety_warnings=0
# llama-benchy c1: 0=78.34, 8K=66.61, 32K=68.09 tg tok/s
# llama-benchy c2: 0=50.05 aggregate / 25.03 per-agent, 8K=21.81 aggregate / 10.91 per-agent, 32K=7.78 aggregate / 3.89 per-agent tg tok/s
# Manual notes: Same development session as Avuja: entered a tool-call loop early in the session.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/Frozenlock/Qwen3.8-27B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/models/model/chat_template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
QUANTIZATION=auto_round
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8_e4m3
PREFIX_CACHE_ARG=--enable-prefix-caching
MAMBA_CACHE_MODE=align
CHUNKED_PREFILL_ARG=--enable-chunked-prefill
# The model card demonstrates n=3; Club-3090 found n=4 the throughput knee on
# this exact quantization. Set MTP_K=0 to benchmark the non-speculative path.
MTP_K=4
# Club-3090 does not enable vLLM async scheduling on this patched GDN+MTP path.
ASYNC_SCHEDULING_ARG=--no-async-scheduling

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
