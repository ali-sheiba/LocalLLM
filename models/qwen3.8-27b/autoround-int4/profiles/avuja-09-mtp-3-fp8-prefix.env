# Avuja/Qwen3.8-27B-int4-AutoRound — MTP smoke experiment
# Source: https://huggingface.co/Avuja/Qwen3.8-27B-int4-AutoRound
#
# The checkpoint retains its complete MTP head in BF16 and its author reports
# native vLLM speculative decoding. Use MTP n=3 rather than Frozenlock's n=4:
# community testing of Avuja reported draft acceptance collapsing to 0% after
# roughly 14.5K generated tokens. Start with an MTP boot/acceptance smoke test;
# do not use this profile for long agent sessions unless it stays stable.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: pending
# Profile SHA-256 at benchmark launch: pending
# tool-eval-bench: pending
# llama-benchy c1: pending
# llama-benchy c2: pending
# Manual notes: pending — verify MTP startup and draft acceptance, then test a >15K-token generation for collapse.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=/home/app/models/Avuja/Qwen3.8-27B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/models/model/chat_template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=/home/app/models/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
QUANTIZATION=auto_round
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8_e4m3
PREFIX_CACHE_ARG=--enable-prefix-caching
MAMBA_CACHE_MODE=align
CHUNKED_PREFILL_ARG=--enable-chunked-prefill
MTP_K=3
ASYNC_SCHEDULING_ARG=--no-async-scheduling

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
