# Avuja experiment 10 — FP8 KV performance base + Froggeric quality synthesis
# Source: https://huggingface.co/Avuja/Qwen3.8-27B-int4-AutoRound
# Comparison: benchmarks/comparisons/avuja-profile-sweep-2026-08-20.md
#
# P04's canonical runtime (FlashInfer + FP8 E4M3 KV) was the strongest
# two-sequence performance profile. P07's Froggeric template was the only
# plausible semantic quality lead, scoring 91 in one trial. This profile tests
# whether those gains compose while restoring a conservative production path:
# two active sequences, async scheduling, no MTP, and no prefix/recurrent cache.
#
# Promotion requires replicated 91+ quality with zero safety warnings, P04-like
# long-context throughput, and a two-agent development soak through compression.
# This profile targets a production Pareto record; it is not expected to exceed
# P09's one-stream MTP c1 record.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: pending
# tool-eval-bench: pending — run at least 3 quality trials before promotion
# llama-benchy: pending
# Manual notes: pending — run two concurrent development sessions through context compression and long tool chains.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/Avuja/Qwen3.8-27B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/etc/qwen-custom-chat-template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=${MODEL_ROOT:-${HOME}/models}/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
VLLM_USE_FLASHINFER_SAMPLER=1
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8_e4m3
PREFIX_CACHE_ARG=--no-enable-prefix-caching
MAMBA_CACHE_MODE=none
CHUNKED_PREFILL_ARG=--enable-chunked-prefill
ASYNC_SCHEDULING_ARG=--async-scheduling
MTP_K=0

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
