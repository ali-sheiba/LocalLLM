# Frozenlock/Qwen3.8-27B-int4-AutoRound — stable two-agent baseline
# Source: https://huggingface.co/Frozenlock/Qwen3.8-27B-int4-AutoRound
#
# W4A16, group size 128, symmetric AutoRound packing. Unlike the earlier
# AutoRound exports, this checkpoint quantizes its MTP head. Keep MTP disabled
# in this unpatched two-agent baseline: the Club-3090 n=4 path requires
# runtime patches and documents an OOM with two sequences on dual RTX 3090s.
# Establish native-template tool-call and long-context stability first.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: benchmarks/runs/2026/08/20260820T123115Z-frozenlock-qwen3-8-27b-int4-autoround-00f126a1/report.md (run 20260820T123115Z-frozenlock-qwen3-8-27b-int4-autoround-00f126a1)
# Profile SHA-256 at benchmark launch: 262ca569f4c0fe7dce7da25ee0c905cbbc0fda9b998048ce1c0b2e5d31f24371
# tool-eval-bench: score=91, completion=—, safety_warnings=0
# llama-benchy c1: 0=68.39, 8K=62.19, 32K=49.25 tg tok/s
# llama-benchy c2: 0=66.23 aggregate / 33.12 per-agent, 8K=22.75 aggregate / 11.37 per-agent, 32K=7.39 aggregate / 3.70 per-agent tg tok/s
# Manual notes: pending — test long coding sessions for loops, stalled calls, and malformed tool calls.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=/home/app/models/Frozenlock/Qwen3.8-27B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/models/model/chat_template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=/home/app/models/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=int8_per_token_head
PREFIX_CACHE_ARG=--no-enable-prefix-caching
MAMBA_CACHE_MODE=none
CHUNKED_PREFILL_ARG=--enable-chunked-prefill

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
