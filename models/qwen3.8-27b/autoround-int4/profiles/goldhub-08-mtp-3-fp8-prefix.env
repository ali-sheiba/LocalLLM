# goldhub/Qwen3.8-27B-INT4-W4A16-AutoRound — MTP source configuration
# Source: https://huggingface.co/goldhub/Qwen3.8-27B-INT4-W4A16-AutoRound
#
# Goldhub documents stable MTP n=3 and recommends this dual-3090 envelope:
# TP=2, 131072 context, two sequences, 2048 batched tokens, and prefix caching.
# The profile combines that recommendation with the author's FP8 E4M3 KV path.
# MTP n=4/5 is explicitly left for later isolated depth experiments.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: pending
# Profile SHA-256 at benchmark launch: pending
# tool-eval-bench: pending
# llama-benchy c1: pending
# llama-benchy c2: pending
# Manual notes: pending — verify MTP startup, tool calls, recurrent-state stability, and c2 behavior before increasing context or MTP depth.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=/home/app/models/goldhub/Qwen3.8-27B-INT4-W4A16-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/models/model/chat_template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=/home/app/models/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
QUANTIZATION=auto_round
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=2048
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8_e4m3
PREFIX_CACHE_ARG=--enable-prefix-caching
MAMBA_CACHE_MODE=align
CHUNKED_PREFILL_ARG=--enable-chunked-prefill
MTP_K=3
ASYNC_SCHEDULING_ARG=--no-async-scheduling

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
