# Minachist/Qwen3.8-27B-INT8-AutoRound — stable two-agent baseline
# Source: https://huggingface.co/Minachist/Qwen3.8-27B-INT8-AutoRound
# Branch: main (the locally downloaded checkpoint)
#
# W8A16. The author recommends the gs128 branch when available, but this
# profile evaluates the installed main branch. INT8 uses more VRAM than INT4;
# keep the 0.90 utilization cap and record an initialization failure if c2
# cannot reserve enough hybrid-cache state at the full 262K model limit.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: pending
# tool-eval-bench: pending
# llama-benchy: pending
# Manual notes: pending — test long coding sessions for loops, stalled calls, and malformed tool calls.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=/home/app/models/Minachist/Qwen3.8-27B-INT8-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/models/model/chat_template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=/home/app/models/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=int8_per_token_head
PREFIX_CACHE_ARG=--no-enable-prefix-caching
MAMBA_CACHE_MODE=none
CHUNKED_PREFILL_ARG=--enable-chunked-prefill

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
