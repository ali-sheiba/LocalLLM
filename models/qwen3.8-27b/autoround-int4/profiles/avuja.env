# Avuja/Qwen3.8-27B-int4-AutoRound — stable two-agent baseline
# Source: https://huggingface.co/Avuja/Qwen3.8-27B-int4-AutoRound
#
# W4A16, group size 128. This checkpoint retains the full MTP head in BF16,
# but MTP is deliberately not enabled here: Club-3090's n=4 path requires
# patches and is documented to OOM at two sequences on two 3090s.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: benchmarks/runs/2026/08/20260819T180403Z-avuja-qwen3-8-27b-int4-autoround-c9f9fb98/report.md (run 20260819T180403Z-avuja-qwen3-8-27b-int4-autoround-c9f9fb98)
# Profile SHA-256 at benchmark launch: d2569b7b94bee82a7e327291c49cef22b7741cd72850387fa33c39f760cc0559
# tool-eval-bench: score=88, completion=—, safety_warnings=1
# llama-benchy c1: 0=68.73, 8K=62.33, 32K=49.32 tg tok/s
# llama-benchy c2: 0=77.21 aggregate / 38.61 per-agent, 8K=29.23 aggregate / 14.61 per-agent, 32K=9.20 aggregate / 4.60 per-agent tg tok/s
# Manual notes: pending — test long coding sessions for loops, stalled calls, and malformed tool calls.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=/home/app/models/Avuja/Qwen3.8-27B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/models/model/chat_template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=/home/app/models/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=int8_per_token_head
PREFIX_CACHE_ARG=--no-enable-prefix-caching
MAMBA_CACHE_MODE=none
CHUNKED_PREFILL_ARG=--enable-chunked-prefill

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
