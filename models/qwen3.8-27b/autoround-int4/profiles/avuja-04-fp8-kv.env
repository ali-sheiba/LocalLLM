# Avuja experiment 04 — FP8 E4M3 KV cache
# Control: avuja.env, run 20260819T180403Z-avuja-qwen3-8-27b-int4-autoround-c9f9fb98
# Change only KV_CACHE_DTYPE from int8_per_token_head to fp8_e4m3.
# Hypothesis: test cache-path performance. Ampere has no native FP8 compute and
# this checkpoint lacks calibrated KV scales, so quality and loops are the gate.
#
# BENCHMARK_SUMMARY_BEGIN
# Latest benchmark: benchmarks/runs/2026/08/20260820T092927Z-avuja-qwen3-8-27b-int4-autoround-53ad978e/report.md (run 20260820T092927Z-avuja-qwen3-8-27b-int4-autoround-53ad978e)
# Profile SHA-256 at benchmark launch: 79efb2b3e0373cbbeaa1875534f47b1826b7c7b5c6996ab24b80dac6ef76aebf
# tool-eval-bench: score=89, completion=—, safety_warnings=0
# llama-benchy c1: 0=70.01, 8K=68.78, 32K=66.40 tg tok/s
# llama-benchy c2: 0=74.05 aggregate / 37.03 per-agent, 8K=28.15 aggregate / 14.07 per-agent, 32K=10.96 aggregate / 5.48 per-agent tg tok/s
# Manual notes: pending — test long coding sessions for loops, stalled calls, and malformed tool calls.
# BENCHMARK_SUMMARY_END

MODEL_HOST_PATH=/home/app/models/Avuja/Qwen3.8-27B-int4-AutoRound
SERVED_MODEL_NAME=qwen3.8-27b
CHAT_TEMPLATE=/models/model/chat_template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=/home/app/models/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

PORT=8080
CUDA_VISIBLE_DEVICES=0,1
DTYPE=bfloat16
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8_e4m3
PREFIX_CACHE_ARG=--no-enable-prefix-caching
MAMBA_CACHE_MODE=none
CHUNKED_PREFILL_ARG=--enable-chunked-prefill

TOOL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
ENABLE_THINKING=false
REASONING_EFFORT=low
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
