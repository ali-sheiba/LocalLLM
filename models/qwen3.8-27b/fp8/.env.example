# Copy to .env, then change one variable at a time for a benchmark sweep.
# The benchmark runner records the resolved values from the started container.

# Official FP8 checkpoint.
MODEL_HOST_PATH=/home/app/models/Qwen/Qwen3.8-27B-FP8
SERVED_MODEL_NAME=qwen3.8-27b

# Model-supplied template (baseline): /models/model/chat_template.jinja
# Custom-template A/B test:
# CHAT_TEMPLATE=/etc/qwen-custom-chat-template.jinja
CUSTOM_CHAT_TEMPLATE_HOST_PATH=/home/app/models/froggeric/Qwen-Fixed-Chat-Templates/chat_template.jinja

# Serving and parallelism
PORT=8080
CUDA_VISIBLE_DEVICES=0,1
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.92
KV_CACHE_DTYPE=int8_per_token_head

# Keep prefix cache disabled with MTP unless explicitly testing the interaction.
PREFIX_CACHE_ARG=--no-enable-prefix-caching
MTP_K=1

# Tool use, template, and sampling
TOOL_PARSER=qwen3_coder
ENABLE_THINKING=false
TEMPERATURE=0.7
TOP_P=0.80
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPETITION_PENALTY=1.0
