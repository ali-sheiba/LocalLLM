# Model file (overrides the default MTP GGUF in the directory)
# MODEL=Qwen3.6-27B-Fable-Fus-711-UnHeretic-NM-DAU-NEO-MAX-NEO-MTP-Q8_0.gguf

# Context window (262K fits Q8_0 27B on dual 3090)
CTX_SIZE=262144

# Prefill batch size
BATCH_SIZE=4096

# UV batch size
UBATCH_SIZE=512

# KV cache quantization
KV_TYPE=q8_0

# Number of batch sequences (2 for parallel sessions)
NP=2

# Sampling
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0
REPEAT_PENALTY=1.0

# Speculative MTP decoding
MTP_DRAFT_N_MAX=2

# Reasoning mode
REASONING=off
REASONING_FORMAT=deepseek